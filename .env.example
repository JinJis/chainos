# ─────────────────────────────────────────────────────────────────────────────
# Chainos environment — copy to .env and fill in. NEVER commit real secrets.
# All LLM/provider keys are SERVER-SIDE ONLY (Engine + pipeline). Never expose
# them to the browser or embed them in client bundles.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Set LLM_OFFLINE=1 to use the deterministic offline provider (no keys needed).
# Default path makes real Anthropic/Google calls when keys are present.
LLM_OFFLINE=0

# ── Model IDs (overridable — verify against current docs before changing) ─────
MODEL_DEEP_ANTHROPIC=claude-opus-4-8
MODEL_MEDIUM_ANTHROPIC=claude-sonnet-4-6
MODEL_LOW_ANTHROPIC=claude-haiku-4-5
MODEL_DEEP_GOOGLE=gemini-3.1-pro-preview
MODEL_MEDIUM_GOOGLE=gemini-3.5-flash
MODEL_LOW_GOOGLE=gemini-3.1-flash-lite
# Default provider per call when an admin project doesn't pin one: anthropic|google
LLM_DEFAULT_PROVIDER=anthropic

# ── RESEARCH tier — autonomous Gemini Deep Research agent ─────────────────────
# Discovers the whole value chain via web research before structuring (falls back
# to google_search grounding if the preview interactions API isn't in the SDK).
MODEL_RESEARCH_GOOGLE=deep-research-preview-04-2026
RESEARCH_MAX=0              # 1 = use the deep-research-max variant (most thorough)
RESEARCH_TIMEOUT_S=900      # max seconds to wait for a research interaction

# ── Neo4j (graph — primary store) ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chainos-dev-pw
# Two-Track separation: distinct logical DBs. Terminal user code reads PRODUCTION only.
NEO4J_STAGING_DB=staging
NEO4J_PRODUCTION_DB=production

# ── PostgreSQL (users, billing, jobs, tickets, metadata, pgvector RAG) ────────
DATABASE_URL=postgresql+psycopg://chainos:chainos-dev-pw@localhost:5432/chainos

# ── Redis (momentum cache, job queue) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Vector DB (Predict RAG). Default to pgvector via DATABASE_URL above. ──────
PINECONE_API_KEY=
VECTOR_BACKEND=pgvector

# ── Market data (licensed feed; default to delayed/static until confirmed) ────
MARKET_DATA_API_KEY=
MARKET_DATA_MODE=delayed

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR.
#   DEBUG = verbose troubleshooting — full agent/LLM/graph/publish trace, both in
#   the engine container logs AND streamed live into the Studio agent console.
# LOG_FORMAT: text (human-readable) | json (structured, one object per line).
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ── Service URLs (frontends call the Engine server-side; keys never shipped) ──
ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
